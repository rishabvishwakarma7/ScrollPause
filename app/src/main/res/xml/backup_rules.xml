<?xml version="1.0" encoding="utf-8"?>
<!--
    Exclude all app data from cloud backup.
    ScrollPause stores only local data; we do not want it synced to Google Drive.
-->
<full-backup-content>
    <exclude domain="sharedpref" path="." />
    <exclude domain="database" path="." />
    <exclude domain="file" path="." />
</full-backup-content>
