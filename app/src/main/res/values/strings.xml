<resources>
    <string name="app_name">ScrollPause</string>
    <string name="app_tagline">Notice your reels. Own your time.</string>

    <!-- Accessibility Service -->
    <string name="accessibility_service_label">ScrollPause Reel Counter</string>
    <string name="accessibility_service_description">
        ScrollPause uses Accessibility access to detect when you are viewing Instagram Reels.
        It counts each Reel you see and measures time spent. It does not read messages,
        captions, usernames, or any personal content. All data stays on your device.
    </string>
    <string name="accessibility_service_summary">Counts Instagram Reels — nothing else</string>

    <!-- Onboarding -->
    <string name="onboarding_skip">Skip</string>
    <string name="onboarding_next">Next</string>
    <string name="onboarding_get_started">Get Started</string>

    <string name="onboarding_page1_title">Know your Reels</string>
    <string name="onboarding_page1_body">
        ScrollPause counts the Instagram Reels you watch. That\'s it.\n\n
        No judgement. No blocking. Just awareness.
    </string>

    <string name="onboarding_page2_title">What we look at</string>
    <string name="onboarding_page2_body">
        We use Android\'s Accessibility API to detect when the Reels viewer is open.\n\n
        We read screen structure — not your messages, captions, or personal details.\n\n
        Stored locally: reel counts, session time, your preferences. Nothing else.\n\n
        No internet connection is used.
    </string>

    <string name="onboarding_page3_title">Two permissions</string>
    <string name="onboarding_page3_body">
        ScrollPause needs two permissions to work.\n\n
        You can revoke them at any time in Android Settings.
    </string>

    <string name="onboarding_accessibility_button">Enable Accessibility Access</string>
    <string name="onboarding_accessibility_hint">Opens Android Accessibility Settings. Find ScrollPause and enable it.</string>
    <string name="onboarding_overlay_button">Allow Display Over Apps</string>
    <string name="onboarding_overlay_hint">Needed only for the floating counter. You can disable the counter in Settings to skip this.</string>

